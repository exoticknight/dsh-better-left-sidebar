{
  "name": "dsh-better-left-sidebar",
  "version": "0.1.2",
  "description": "A cleaner, better-organized DeepSeek Harness sidebar with support for multiple plugin-defined widgets.",
  "icon": "./icon.svg",
  "license": "Apache-2.0",
  "author": "exoticknight",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "sidebar",
    "left-sidebar",
    "sidebar-customization",
    "navigation",
    "conversation",
    "widgets",
    "compact-rail",
    "compact-widgets",
    "custom-widgets",
    "plugin-widgets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exoticknight/dsh-better-left-sidebar.git"
  },
  "homepage": "https://github.com/exoticknight/dsh-better-left-sidebar#readme",
  "bugs": {
    "url": "https://github.com/exoticknight/dsh-better-left-sidebar/issues"
  },
  "template": {
    "name": "dsh-plugin-template",
    "author": "exoticknight",
    "url": "https://github.com/exoticknight/dsh-plugin-template"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.2.2-0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./slots": {
      "types": "./lib/slots.d.ts"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/slots.d.ts",
    "icon.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "configForms"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:package": "node scripts/check-package.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm check:package",
    "hooks:install": "simple-git-hooks",
    "dev": "node scripts/dev.mjs start",
    "dev:cli": "node scripts/dev.mjs cli",
    "dev:install": "node scripts/dev.mjs install",
    "dev:dsh": "node scripts/dev.mjs run",
    "dev:clean": "node scripts/dev.mjs clean",
    "smoke": "node scripts/smoke.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "19.3.1",
    "semver": "^7.8.5",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "config": {
    "dshVersion": "0.2.1-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.2.2-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
